# Copy to .env (git-ignored). docker compose reads it from this directory.
# Variables set in your shell take precedence over this file.

# Fine-grained personal access token, the same kind as for the Linux runners (see ../README.md).
RUNNER_ACCESS_TOKEN=

RUNNER_REPOSITORY=sxpersxnic/budget

# WINDOWS_RUNNER (repository variable) must name one of these labels.
# self-hosted, Windows and X64 are added automatically.
RUNNER_LABELS=budget-windows
RUNNER_NAME_PREFIX=budget-windows

# Container resources. PyInstaller and Inno Setup need a few GB.
RUNNER_MEMORY=8g
RUNNER_CPUS=4

# Windows Server Core base image; it must not be newer than the host
# (ltsc2022 for Windows Server 2022 and Windows 11, ltsc2025 for Windows Server 2025).
WINDOWS_TAG=ltsc2022
