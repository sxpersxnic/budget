# Copy to .env (git-ignored). docker compose reads it from this directory.
# Variables exported in your shell take precedence over this file.

# Fine-grained personal access token (github.com → Settings → Developer settings):
#   Repository access:      Only select repositories → sxpersxnic/budget
#   Repository permissions: Administration → Read and write (Metadata: Read is added automatically)
# Used only to fetch runner registration tokens. When it expires, runners can no longer register.
RUNNER_ACCESS_TOKEN=

# owner/repo the runners register with
RUNNER_REPOSITORY=sxpersxnic/budget

# Number of runners. Two lets a pull request's CI run next to an installer build.
RUNNER_REPLICAS=2

# Comma-separated custom labels; LINUX_RUNNER (repository variable) must name one of them.
# self-hosted, Linux and X64 are added automatically.
RUNNER_LABELS=budget-linux
RUNNER_NAME_PREFIX=budget

# linux/amd64 matches GitHub's runners; linux/arm64 runs natively on Apple Silicon but
# then builds an aarch64 Linux installer.
RUNNER_PLATFORM=linux/amd64

# myoung34/github-runner tag. Keep it on Ubuntu 22.04 (jammy): the Linux installer is built
# against its glibc. The runner updates itself between releases; raise the tag now and then.
RUNNER_IMAGE_TAG=2.338.0-ubuntu-jammy
