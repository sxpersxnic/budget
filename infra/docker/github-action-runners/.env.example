# Settings for runners.sh. `just runners-setup` copies this to .env (git-ignored) and asks for
# the token. Only this Mac reads this file; the PC gets the WINDOWS_* settings without the token.

# Fine-grained personal access token (github.com → Settings → Developer settings):
#   Repository access:      Only select repositories → sxpersxnic/budget
#   Repository permissions: Administration → Read and write (Metadata: Read is added automatically)
RUNNER_ACCESS_TOKEN=
RUNNER_REPOSITORY=sxpersxnic/budget

# Linux: Docker on this Mac. Two runners let a pull request's CI run next to an installer build.
LINUX_RUNNERS=2
# linux/amd64 matches GitHub's runners (Rosetta on Apple Silicon); linux/arm64 would build an
# aarch64 Linux installer.
LINUX_PLATFORM=linux/amd64
# myoung34/github-runner tag; stay on Ubuntu 22.04 (jammy), whose glibc the installer targets.
LINUX_IMAGE_TAG=2.338.0-ubuntu-jammy

# Windows: Docker in Windows-container mode on the PC, reached over SSH (key-based login).
WINDOWS_SSH_HOST=pc-01
WINDOWS_RUNNERS=1
# Folder on the PC, in the SSH user's home, that holds the image files.
WINDOWS_DIR=budget-runner-windows
# Windows Server Core base image; must not be newer than the PC's Windows.
WINDOWS_TAG=ltsc2025
WINDOWS_MEMORY=8g
WINDOWS_CPUS=4

# macOS: Tart VMs on this Mac (at most 2 at a time).
MACOS_RUNNERS=1
# Cirrus Labs image with Homebrew and the Tart guest agent; must not be newer than this Mac.
MACOS_IMAGE=ghcr.io/cirruslabs/macos-tahoe-base:latest
MACOS_CPUS=4
MACOS_MEMORY=8192
MACOS_RUNNER_VERSION=2.338.0
MACOS_RUNNER_SHA256=df4cebda25c86a886ed204e49fee63f5c2e7cec5f447b5c98440a826bbdf9df2
# Tart, installed into ~/Applications/tart.app from its GitHub release (the Homebrew tap is outdated).
TART_VERSION=2.41.1
TART_SHA256=e680a734febccfce7d4e910c1f7f13fc3b00f19a181c945e2d746de3214c32c2
