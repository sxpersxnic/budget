# Copy to .env (git-ignored). runner.sh reads it from this directory.

# Fine-grained personal access token, the same kind as for the Linux runners (see ../README.md).
RUNNER_ACCESS_TOKEN=

RUNNER_REPOSITORY=sxpersxnic/budget

# MACOS_RUNNER (repository variable) must name one of these labels.
# self-hosted, macOS and ARM64 are added automatically.
RUNNER_LABELS=budget-macos
RUNNER_NAME_PREFIX=budget-macos

# Cirrus Labs image with Homebrew and the Tart guest agent (needed for `tart exec`).
# The macOS version sets the oldest macOS the app is tested to build on; it must not be newer
# than this Mac.
MACOS_IMAGE=ghcr.io/cirruslabs/macos-tahoe-base:latest

# VM size; applied by `runner.sh prepare`.
VM_CPUS=4
VM_MEMORY=8192

# GitHub runner installed into the template VM by `runner.sh prepare`.
RUNNER_VERSION=2.338.0
RUNNER_SHA256=df4cebda25c86a886ed204e49fee63f5c2e7cec5f447b5c98440a826bbdf9df2
